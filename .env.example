# Copy to .env and fill in real values. Do NOT commit your real .env.

# Bot User OAuth Token (starts with xoxb-). Found under
# "OAuth & Permissions" in your Slack app settings.
SLACK_BOT_TOKEN=xoxb-your-bot-token

# App-Level Token (starts with xapp-) with the connections:write scope.
# Required for Socket Mode. Generated under "Basic Information" ->
# "App-Level Tokens".
SLACK_APP_TOKEN=xapp-your-app-level-token

# Word that triggers an auto-reply (case-insensitive). Defaults to "umer".
TRIGGER_WORD=umer
